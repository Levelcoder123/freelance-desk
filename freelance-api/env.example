# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freelance_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freelance_test
DB_SSL=false

# Individual fields (used by docker-compose)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=freelance_db
DB_HOST=localhost
DB_PORT=5432

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redispass@localhost:6379
REDIS_PASSWORD=redispass
REDIS_PORT=6379

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-32-chars-minimum-random-string
JWT_REFRESH_SECRET=change-me-another-32-chars-minimum
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=Freelance Desk <noreply@yourdomain.com>

# ── File Storage (S3-compatible) ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=freelance-api-uploads

# ── PDF Generation ────────────────────────────────────────────────────────────
PUPPETEER_SKIP_DOWNLOAD=false   # set true if using a system Chrome

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000     # 15 min
RATE_LIMIT_MAX=100
